# Copy the variable names into:
# C:\Users\DrYam\.secrets\destiny2\bungie.env
#
# Do not put real API keys in this project folder.

BUNGIE_API_KEY=replace_with_your_bungie_api_key

# Optional. Use only if OAuth is needed later for opt-in user/account data.
BUNGIE_CLIENT_ID=replace_with_your_client_id
BUNGIE_CLIENT_SECRET=replace_with_your_client_secret
BUNGIE_REDIRECT_URI=https://localhost:8787/auth/callback
